# Core service
HOST=0.0.0.0
PORT=18789
PUBLIC_BASE_URL=http://localhost:18789
SERVICE_NAME=model-api
DASHBOARD_PORT=3000
NEXT_PUBLIC_PUBLIC_API_URL=http://localhost:18789
API_BACKEND_URL=http://127.0.0.1:18789
NEXT_PUBLIC_CHAT_URL=
DATABASE_URL=file:./data/gateway.db
UPLOAD_DIR=data/uploads
CONFIG_PATH=config/providers.yml

# Required secrets. Generate them before first start; never commit .env.
MASTER_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Leave empty for localhost or when dashboard and API use the same host.
# For sibling subdomains such as console.example.com + api.example.com use .example.com
ADMIN_COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000

# Provider credentials. Only fill the providers you enable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
CHATGPT_AUTHORIZATION=

# Privacy and optional tools
ENABLE_PROMPT_LOGGING=false
WEB_SEARCH_BACKEND=searxng
SEARXNG_URL=http://localhost:8080
WEB_SEARCH_TIMEOUT_MS=10000
WEB_SEARCH_MAX_RESULTS=5
CHAT_AGENT_MAX_STEPS=15
CHAT_CONTEXT_MAX_MESSAGES=40

# Optional: only for docker-compose.cloudflare.yml (remotely managed tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
